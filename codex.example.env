# Set these before first start; later installation settings use the original settings API.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Optional: published interactive card template from cards/dingtalk-superagent.json.
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_NAME=Super agent
SUPERAGENT_REPOSITORY=/absolute/path/to/local/repository
SUPERAGENT_GITHUB_REPOSITORY=owner/repository
SUPERAGENT_GITHUB_CLI=gh
# Optional commit email override; applies on startup, including existing installations.
# SUPERAGENT_GITHUB_COMMIT_EMAIL=you@example.com
# Optional GitHub App installation identity (first start seeds Source settings).
SUPERAGENT_GITHUB_AUTH=user
# SUPERAGENT_GITHUB_APP_ID=123456
# SUPERAGENT_GITHUB_INSTALLATION_ID=12345678
# For upstream + fork, use repository mappings instead of the single installation ID:
# SUPERAGENT_GITHUB_INSTALLATIONS='[{"repository":"alibaba/neug","installationId":"12345678"},{"repository":"your-login/neug","installationId":"87654321"}]'
# SUPERAGENT_GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/neug-agent.pem
SUPERAGENT_STATE_DIR=/absolute/path/to/state-codex
SUPERAGENT_MAX_WORKERS=3
SUPERAGENT_PORT=3082
CODEX_BINARY=codex
CODEX_MODEL=gpt-6.1-sol
# read-only | workspace-write | danger-full-access (host execution without approval)
CODEX_SANDBOX=read-only
