# 可选的钉钉机器人接入。启用时同时填写 CLIENT_ID 和 CLIENT_SECRET。
# 可选交互卡片模板 ID和机器人显示名称。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_NAME=Super-Org
# 可选。限制机器人只接收这个群的 @ 消息。
# DINGTALK_OPEN_CONVERSATION_ID=
# 项目对应的群会话 ID 在「编辑项目」中设置。
# GitHub 事件通知的钉钉群 conversationId。
DINGTALK_GITHUB_NOTIFY_CONVERSATION_ID=

# 项目仓库在「编辑项目」中填写 owner/name，可留空。
SUPERAGENT_GITHUB_CLI=gh
# 启用部署级单仓库监听时，启动会同步该仓库的管理员名单。
# 导出失败会停止启动并保留原名单；钉钉白名单不受影响。
# GitHub 认证方式：user 或 app，默认 user。
SUPERAGENT_GITHUB_AUTH=user
# 可选：覆盖 bot 提交邮箱；每次启动均应用到已有实例。
# SUPERAGENT_GITHUB_COMMIT_EMAIL=agent@example.com

# GitHub App 认证配置，仅在认证方式为 app 时使用。
# SUPERAGENT_GITHUB_APP_ID=123456
# 单仓库使用 INSTALLATION_ID；多仓库使用 INSTALLATIONS，二选一。
# SUPERAGENT_GITHUB_INSTALLATION_ID=12345678
# SUPERAGENT_GITHUB_INSTALLATIONS='[{"repository":"owner/repository","installationId":"12345678"},{"repository":"team/another-repository","installationId":"87654321"}]'
# SUPERAGENT_GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem

# 状态目录，默认 ./state-codex。
# SUPERAGENT_STATE_DIR=/absolute/path/to/super-org/state-codex
SUPERAGENT_MAX_WORKERS=3
SUPERAGENT_PORT=3082

# 项目管理模式可指定本机网卡地址。局域网访问默认关闭。
# SUPERAGENT_PROJECT_PREVIEW_IP=192.168.1.10
SUPERAGENT_PROJECT_PREVIEW_LAN=0

# 项目管理模式的公网入口，默认关闭。反向代理通过 HTTPS 提供对外访问。
SUPERAGENT_PROJECT_PUBLIC_ENABLED=0
# SUPERAGENT_PROJECT_PUBLIC_ORIGIN=https://projects.example.com
# SUPERAGENT_PROJECT_PUBLIC_PORT=3092
# SUPERAGENT_PROJECT_PUBLIC_USER=projects
# 在本机配置文件中填写密码，可用 openssl rand -hex 24 生成。
# SUPERAGENT_PROJECT_PUBLIC_PASSWORD=

# Codex 可执行文件命令名或路径，默认 codex。
CODEX_BINARY=codex
# CODEX_MODEL=按账号可用模型填写
# 沙箱模式：read-only、workspace-write 或 danger-full-access。
# workspace-write 允许 Worker 修改任务 worktree；主机直执行模式见使用说明。
CODEX_SANDBOX=workspace-write

# The project workspace lists detected local agents. Codex currently provides the complete runtime.

# 以下变量由 scripts/dsh-superagent 服务管理脚本读取。
# 通过终端环境或 source 导出；该脚本不会自动加载本文件。
# DSH profile 名称，默认 superagent。
DSH_SUPERAGENT_PROFILE=superagent
# 服务地址，默认 http://127.0.0.1:3082。
DSH_SUPERAGENT_URL=http://127.0.0.1:3082
# 示例路径中的 ~ 表示用户主目录；使用 --env-file 加载前请替换为实际绝对路径。
# Node.js 的 env 文件加载器不会自动展开 ~。

