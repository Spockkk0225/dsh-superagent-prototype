# 钉钉机器人：CLIENT_ID 和 CLIENT_SECRET 为启动必填项。
# 可选交互卡片模板 ID和机器人显示名称。
DINGTALK_CLIENT_ID=********
DINGTALK_CLIENT_SECRET=********
DINGTALK_CARD_TEMPLATE_ID=********
DINGTALK_ROBOT_NAME=NeuG机器人

SUPERAGENT_REPOSITORY=~/agent-workspace/neug
SUPERAGENT_GITHUB_REPOSITORY=alibaba/neug
SUPERAGENT_GITHUB_CLI=~/agent-workspace/.tools/gh_2.103.3_macOS_arm64/bin/gh
# GitHub 认证方式：user 或 app，默认 user。
SUPERAGENT_GITHUB_AUTH=app
# 可选：覆盖 bot 提交邮箱；每次启动均应用到已有实例。
SUPERAGENT_GITHUB_COMMIT_EMAIL=yu.shao@alibaba-inc.com

# GitHub App 认证配置，仅在认证方式为 app 时使用。
SUPERAGENT_GITHUB_APP_ID=********
# 单仓库使用 INSTALLATION_ID；多仓库使用 INSTALLATIONS，二选一。
SUPERAGENT_GITHUB_INSTALLATION_ID=********
SUPERAGENT_GITHUB_INSTALLATIONS='[{"repository":"alibaba/neug","installationId":"********"},{"repository":"Spockkk0225/neug","installationId":"********"}]'
SUPERAGENT_GITHUB_PRIVATE_KEY_PATH=~/agent-workspace/********.private-key.pem

# 状态目录，默认 ./state-codex。
SUPERAGENT_STATE_DIR=~/agent-workspace/dsh-superagent-prototype/state-codex
SUPERAGENT_MAX_WORKERS=3
SUPERAGENT_PORT=3082

# Codex 可执行文件命令名或路径，默认 codex。
CODEX_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex
CODEX_MODEL=gpt-6.1-sol
# 沙箱模式：read-only、workspace-write 或 danger-full-access。
# 建议开启danger-full-access，否则可能无法认证gh。
CODEX_SANDBOX=danger-full-access

# 以下变量由 scripts/dsh-superagent 服务管理脚本读取。
# 通过终端环境或 source 导出；该脚本不会自动加载本文件。
# DSH profile 名称，默认 superagent。
DSH_SUPERAGENT_PROFILE=superagent
# 服务地址，默认 http://127.0.0.1:3082。
DSH_SUPERAGENT_URL=http://127.0.0.1:3082
# 示例路径中的 ~ 表示用户主目录；使用 --env-file 加载前请替换为实际绝对路径。
# Node.js 的 env 文件加载器不会自动展开 ~。

