#!/usr/bin/env python3
"""Export repository admin users as the existing GitHub allowed-list JSON."""
import json
import subprocess
import sys


def export(repository, cli='gh'):
    result = subprocess.run(
        [cli, 'api', f'repos/{repository}/collaborators?permission=admin&per_page=100', '--paginate', '--slurp'],
        check=True, capture_output=True, text=True, timeout=90,
    )
    pages = json.loads(result.stdout)
    admins = {user['login'] for page in pages for user in page
              if user['permissions']['admin'] is True and user['type'] == 'User'}
    return [{'id': login} for login in sorted(admins, key=str.lower)]


if __name__ == '__main__':
    if len(sys.argv) not in (2, 3):
        sys.exit('Usage: python3 scripts/export-github-admins owner/repo [gh-cli]')
    print(json.dumps(export(*sys.argv[1:])))
